{
  "inputCamera": {
    "devicePath": "0",
    "width": 1280,
    "height": 720,
    "fps": 30,
    "crop": {
      "x": 0,
      "y": 0,
      "width": 1280,
      "height": 720
    }
  },
  "outputCamera": {
    "devicePath": "output/virtual-cam-preview.mp4",
    "backend": "opencv",
    "width": 1280,
    "height": 720,
    "fps": 30
  },
  "segmentation": {
    "backend": "selfie",
    "threshold": 0.65,
    "selfie": {
      "modelSelection": 1,
      "temporalSmoothing": 0.25
    },
    "edgeSmoothness": 0.5,
    "blendFeather": 0.35
  },
  "background": {
    "mode": "chroma",
    "chromaColor": [
      0,
      0,
      0
    ],
    "colorBlendAlpha": 0.35
  },
  "crop": {
    "margin": 0.25,
    "smoothing": 0.85
  }
}
