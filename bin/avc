#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
  cat <<'USAGE'
Usage:
  ./bin/avc <command> [args...]

Single Entrypoint:
  Use only `./bin/avc` as the user-facing entrypoint.

Commands:
  setup            Install host dependencies for current OS
  config           Launch interactive config generator
  config-gui       Launch GUI config generator
  serve            Start virtual camera stream service from saved config
  mac-camera-install
                   Install/prepare macOS CMIO virtual camera runtime (WIP)
  mac-camera-status
                   Check macOS CMIO virtual camera runtime status (WIP)
  entrypoint       Run container entrypoint script
  doctor           Basic runtime checks (python3, docker)
USAGE
}

cmd="${1:-}"
if [[ -z "$cmd" ]]; then
  usage
  exit 1
fi
shift || true

case "$cmd" in
  setup) exec "$ROOT_DIR/scripts/bin/avc-setup" "$@" ;;
  config) exec "$ROOT_DIR/scripts/bin/avc-config" "$@" ;;
  config-gui) exec "$ROOT_DIR/scripts/bin/avc-config-gui" "$@" ;;
  serve) exec "$ROOT_DIR/scripts/bin/avc-serve" "$@" ;;
  mac-camera-install) exec "$ROOT_DIR/scripts/bin/avc-mac-camera-install" "$@" ;;
  mac-camera-status) exec "$ROOT_DIR/scripts/bin/avc-mac-camera-status" "$@" ;;
  entrypoint) exec "$ROOT_DIR/scripts/bin/avc-entrypoint" "$@" ;;
  doctor) exec "$ROOT_DIR/scripts/bin/avc-doctor" "$@" ;;
  -h|--help) usage ;;
  *)
    echo "Unknown command: $cmd" >&2
    usage >&2
    exit 1
    ;;
esac
