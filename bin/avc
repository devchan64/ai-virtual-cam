#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
  cat <<'USAGE'
Usage:
  ./bin/avc <command> [args...]

Single Entrypoint:
  Use only `./bin/avc` as the user-facing entrypoint.

Commands:
  setup            Install host dependencies for current OS
  env              Manage Python environment (.venv)
  test             Run project spec tests
  config           Launch GUI config generator
  serve            Start virtual camera stream service from saved config
  docker           Run Linux Docker workflows for config/serve
  device           Manage host virtual camera/audio devices
  audio-mixer      Run virtual audio mixer (microphone gate scaffold)
  doctor           Basic runtime checks (python3)
USAGE
}

cmd="${1:-}"
if [[ -z "$cmd" ]]; then
  usage
  exit 1
fi
shift || true

case "$cmd" in
  setup) exec "$ROOT_DIR/scripts/bin/avc-setup" "$@" ;;
  env) exec "$ROOT_DIR/scripts/bin/avc-env" "$@" ;;
  test) exec "$ROOT_DIR/scripts/bin/avc-test" "$@" ;;
  config) exec "$ROOT_DIR/scripts/bin/avc-config" "$@" ;;
  serve) exec "$ROOT_DIR/scripts/bin/avc-serve" "$@" ;;
  docker) exec "$ROOT_DIR/scripts/bin/avc-docker" "$@" ;;
  device) exec "$ROOT_DIR/scripts/bin/avc-device" "$@" ;;
  audio-mixer) exec "$ROOT_DIR/scripts/bin/avc-audio-mixer" "$@" ;;
  doctor) exec "$ROOT_DIR/scripts/bin/avc-doctor" "$@" ;;
  -h|--help) usage ;;
  *)
    echo "Unknown command: $cmd" >&2
    usage >&2
    exit 1
    ;;
esac
