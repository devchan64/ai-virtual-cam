#!/usr/bin/env bash
set -euo pipefail

CAMERA_DEVICE="${AVC_OUTPUT_DEVICE:-/dev/video10}"
CAMERA_LABEL="${AVC_CAMERA_LABEL:-ai-virtual-cam}"
CAMERA_EXCLUSIVE_CAPS="${AVC_CAMERA_EXCLUSIVE_CAPS:-1}"
AUDIO_SINK_NAME="${AVC_AUDIO_SINK_NAME:-ai-virtual-cam}"
AUDIO_SINK_DESC="${AVC_AUDIO_SINK_DESC:-ai-virtual-cam}"
AUDIO_SOURCE_NAME="${AVC_AUDIO_SOURCE_NAME:-ai-virtual-cam-mic}"
AUDIO_SOURCE_DESC="${AVC_AUDIO_SOURCE_DESC:-ai-virtual-cam-mic}"
HOST_UID="${AVC_HOST_UID:-}"
HOST_GID="${AVC_HOST_GID:-}"
HOST_USER="${AVC_HOST_USER:-}"
HOST_HOME="${AVC_HOST_HOME:-}"
DEBUG="${AVC_DEVICE_DEBUG:-0}"
REQUEST_DIR="${AVC_DEVICE_REQUEST_DIR:-}"

usage() {
  cat <<'EOF'
Usage:
  ./bin/avc device <camera|audio> <create|delete|status> [options]

Environment:
  AVC_OUTPUT_DEVICE      Camera device path (default: /dev/video10)
  AVC_CAMERA_LABEL       v4l2loopback card label (default: ai-virtual-cam)
  AVC_CAMERA_EXCLUSIVE_CAPS  v4l2loopback exclusive_caps (default: 1)
  AVC_AUDIO_SINK_NAME    PulseAudio sink name (default: ai-virtual-cam)
  AVC_AUDIO_SINK_DESC    PulseAudio sink description (default: ai-virtual-cam)
  AVC_AUDIO_SOURCE_NAME  PulseAudio source name (default: ai-virtual-cam-mic)
  AVC_AUDIO_SOURCE_DESC  PulseAudio source description (default: ai-virtual-cam-mic)

Options:
  --exclusive-caps <0|1>  Override camera create exclusive_caps
EOF
}

fail() {
  echo "[avc-device] ERROR: $*" >&2
  exit 2
}

dbg() {
  [[ "$DEBUG" == "1" ]] || return 0
  echo "[avc-device][debug] $*" >&2
}

request_via_host_executor() {
  local target="$1"
  local action="$2"
  if [[ -z "$REQUEST_DIR" ]]; then
    json_err "$target:$action" "AVC_DEVICE_REQUEST_DIR is not set in container" "set AVC_DEVICE_REQUEST_DIR and mount shared request directory"
    return 2
  fi
  mkdir -p "$REQUEST_DIR/pending" "$REQUEST_DIR/done" "$REQUEST_DIR/error"
  local req_id req_file out_file
  req_id="$(date +%s%N)-$$"
  req_file="$REQUEST_DIR/pending/${req_id}.req"
  out_file="$REQUEST_DIR/done/${req_id}.json"
  cat > "$req_file" <<EOF
TARGET=$target
ACTION=$action
AVC_AUDIO_SINK_NAME=$AUDIO_SINK_NAME
AVC_AUDIO_SINK_DESC=$AUDIO_SINK_DESC
AVC_AUDIO_SOURCE_NAME=$AUDIO_SOURCE_NAME
AVC_AUDIO_SOURCE_DESC=$AUDIO_SOURCE_DESC
EOF
  local i
  for i in $(seq 1 150); do
    if [[ -f "$out_file" ]]; then
      cat "$out_file"
      rm -f "$out_file"
      return 0
    fi
    sleep 0.1
  done
  json_err "$target:$action" "host executor timeout" "check avc-host-device-executor process and logs"
  return 2
}

require_linux() {
  [[ "$(uname -s)" == "Linux" ]] || fail "device command is supported only on Linux."
}

require_cmd() {
  local name="$1"
  command -v "$name" >/dev/null 2>&1 || fail "required command not found: $name"
}

run_sudo_cmd() {
  if [[ -t 0 && -t 1 ]]; then
    sudo "$@"
    return $?
  fi
  if command -v pkexec >/dev/null 2>&1; then
    pkexec "$@"
    return $?
  fi
  return 1
}

json_ok() {
  local requested="$1"
  local action="$2"
  printf '{"ok":true,"requested":"%s","action":"%s"}\n' "$requested" "$action"
}

json_err() {
  local requested="$1"
  local reason="$2"
  local action="$3"
  printf '{"ok":false,"requested":"%s","reason":"%s","action":"%s"}\n' "$requested" "$reason" "$action"
}

run_pactl_cmd() {
  local runtime_dir="${XDG_RUNTIME_DIR:-}"
  if [[ -z "$runtime_dir" && -n "$HOST_UID" ]]; then
    runtime_dir="/run/user/$HOST_UID"
  fi
  local pulse_server="${PULSE_SERVER:-}"
  if [[ -z "$pulse_server" && -n "$runtime_dir" ]]; then
    pulse_server="unix:${runtime_dir}/pulse/native"
  fi
  local dbus_addr="${DBUS_SESSION_BUS_ADDRESS:-}"
  if [[ -z "$dbus_addr" && -n "$runtime_dir" ]]; then
    dbus_addr="unix:path=${runtime_dir}/bus"
  fi
  local host_home="${HOST_HOME:-${HOME:-}}"
  if [[ -n "$HOST_UID" ]]; then
    local uid_home
    uid_home="$(getent passwd "$HOST_UID" | cut -d: -f6 || true)"
    if [[ -z "$HOST_HOME" && -n "$uid_home" ]]; then
      host_home="$uid_home"
    fi
  fi
  local pulse_cookie=""
  if [[ -n "$runtime_dir" && -f "${runtime_dir}/pulse/cookie" ]]; then
    pulse_cookie="${runtime_dir}/pulse/cookie"
  elif [[ -n "$host_home" && -f "${host_home}/.config/pulse/cookie" ]]; then
    pulse_cookie="${host_home}/.config/pulse/cookie"
  fi
  local -a env_args=(
    "HOME=$host_home"
    "XDG_RUNTIME_DIR=$runtime_dir"
    "PULSE_SERVER=$pulse_server"
    "DBUS_SESSION_BUS_ADDRESS=$dbus_addr"
  )
  if [[ -n "$pulse_cookie" ]]; then
    env_args+=("PULSE_COOKIE=$pulse_cookie")
  fi

  dbg "pactl context: euid=${EUID} host_user=${HOST_USER:-<empty>} host_uid=${HOST_UID:-<empty>} home=${host_home:-<empty>} runtime=${runtime_dir:-<empty>} pulse=${pulse_server:-<empty>} dbus=${dbus_addr:-<empty>}"

  if [[ "${EUID}" -eq 0 ]]; then
    if [[ -n "$HOST_USER" ]] && command -v sudo >/dev/null 2>&1; then
      dbg "pactl via sudo -u $HOST_USER"
      env "${env_args[@]}" sudo -u "$HOST_USER" -H pactl "$@"
      return $?
    fi
    if [[ -n "$HOST_UID" && -n "$HOST_GID" ]] && command -v setpriv >/dev/null 2>&1; then
      dbg "pactl via setpriv uid=$HOST_UID gid=$HOST_GID"
      env "${env_args[@]}" \
        setpriv --reuid "$HOST_UID" --regid "$HOST_GID" --init-groups pactl "$@"
      return $?
    fi
    if [[ -n "$HOST_USER" ]] && command -v runuser >/dev/null 2>&1; then
      dbg "pactl via runuser -u $HOST_USER"
      env "${env_args[@]}" \
        runuser -u "$HOST_USER" -- pactl "$@"
      return $?
    fi
  fi
  env "${env_args[@]}" pactl "$@"
}

camera_video_no() {
  local path="$1"
  [[ "$path" =~ ^/dev/video([0-9]+)$ ]] || fail "invalid AVC_OUTPUT_DEVICE: $path (expected /dev/videoN)"
  echo "${BASH_REMATCH[1]}"
}

camera_create() {
  local requested="camera:create"
  require_cmd sudo
  require_cmd modprobe
  local video_no
  video_no="$(camera_video_no "$CAMERA_DEVICE")"

  local args=(
    "devices=1"
    "video_nr=$video_no"
    "card_label=$CAMERA_LABEL"
    "exclusive_caps=$CAMERA_EXCLUSIVE_CAPS"
    "max_buffers=2"
  )

  if ! run_sudo_cmd modprobe videodev; then
    json_err "$requested" "videodev module load failed" "use interactive sudo (TTY) or pkexec (GUI auth prompt)"
    exit 2
  fi

  if ! run_sudo_cmd modprobe v4l2loopback "${args[@]}"; then
    json_err "$requested" "v4l2loopback load failed" "use interactive sudo (TTY) or pkexec (GUI auth prompt)"
    exit 2
  fi

  if [[ ! -e "$CAMERA_DEVICE" ]]; then
    json_err "$requested" "device was not created at $CAMERA_DEVICE" "verify kernel module and video_nr"
    exit 2
  fi

  json_ok "$requested" "created $CAMERA_DEVICE"
}

camera_delete() {
  local requested="camera:delete"
  require_cmd sudo
  require_cmd modprobe
  if ! run_sudo_cmd modprobe -r v4l2loopback; then
    json_err "$requested" "v4l2loopback unload failed" "close camera users, then retry with interactive sudo (TTY) or pkexec (GUI auth prompt)"
    exit 2
  fi
  json_ok "$requested" "deleted v4l2loopback"
}

camera_status() {
  local requested="camera:status"
  require_cmd lsmod
  local loaded="false"
  local exists="false"
  if lsmod | grep -q '^v4l2loopback'; then
    loaded="true"
  fi
  if [[ -e "$CAMERA_DEVICE" ]]; then
    exists="true"
  fi
  printf '{"ok":true,"requested":"%s","moduleLoaded":%s,"deviceExists":%s,"devicePath":"%s"}\n' \
    "$requested" "$loaded" "$exists" "$CAMERA_DEVICE"
}

audio_create() {
  local requested="audio:create"
  require_cmd pactl
  local sinks
  if ! sinks="$(run_pactl_cmd list short sinks 2>&1)"; then
    json_err "$requested" "pactl list sinks failed: $sinks" "check PulseAudio/PipeWire runtime and permissions"
    exit 2
  fi
  local sink_exists="false"
  local source_exists="false"
  if printf '%s\n' "$sinks" | awk '{print $2}' | grep -Fxq "$AUDIO_SINK_NAME"; then
    sink_exists="true"
  fi
  local sources
  if ! sources="$(run_pactl_cmd list short sources 2>&1)"; then
    json_err "$requested" "pactl list sources failed: $sources" "check PulseAudio/PipeWire runtime and permissions"
    exit 2
  fi
  if printf '%s\n' "$sources" | awk '{print $2}' | grep -Fxq "$AUDIO_SOURCE_NAME"; then
    source_exists="true"
  fi
  local out_sink=""
  local out_source=""
  if [[ "$sink_exists" != "true" ]]; then
    if ! out_sink="$(run_pactl_cmd load-module module-null-sink sink_name="$AUDIO_SINK_NAME" sink_properties="device.description=$AUDIO_SINK_DESC" 2>&1)"; then
      json_err "$requested" "pactl load-module module-null-sink failed: $out_sink" "check PulseAudio/PipeWire runtime and permissions"
      exit 2
    fi
  fi
  if [[ "$source_exists" != "true" ]]; then
    if ! out_source="$(run_pactl_cmd load-module module-remap-source source_name="$AUDIO_SOURCE_NAME" master="$AUDIO_SINK_NAME.monitor" source_properties="device.description=$AUDIO_SOURCE_DESC" 2>&1)"; then
      json_err "$requested" "pactl load-module module-remap-source failed: $out_source" "check PulseAudio/PipeWire runtime and permissions"
      exit 2
    fi
  fi
  if [[ "$sink_exists" == "true" && "$source_exists" == "true" ]]; then
    json_ok "$requested" "already exists: sink=$AUDIO_SINK_NAME source=$AUDIO_SOURCE_NAME"
    return
  fi
  json_ok "$requested" "created sink=$AUDIO_SINK_NAME source=$AUDIO_SOURCE_NAME sink_module=${out_sink//$'\n'/ } source_module=${out_source//$'\n'/ }"
}

audio_delete() {
  local requested="audio:delete"
  require_cmd pactl
  local sink_ids
  local source_ids
  local modules
  if ! modules="$(run_pactl_cmd list short modules 2>&1)"; then
    json_err "$requested" "pactl list modules failed: $modules" "check PulseAudio/PipeWire runtime and permissions"
    exit 2
  fi
  source_ids="$(printf '%s\n' "$modules" | awk -v n="$AUDIO_SOURCE_NAME" '$2=="module-remap-source" && $0 ~ ("source_name=" n "([[:space:]]|$)") {print $1}')"
  sink_ids="$(printf '%s\n' "$modules" | awk -v n="$AUDIO_SINK_NAME" '$2=="module-null-sink" && $0 ~ ("sink_name=" n "([[:space:]]|$)") {print $1}')"
  local id
  while IFS= read -r id; do
    [[ -z "$id" ]] && continue
    if ! run_pactl_cmd unload-module "$id" >/dev/null 2>&1; then
      json_err "$requested" "pactl unload-module failed: remap-source id=$id" "close clients using source and retry"
      exit 2
    fi
  done <<< "$source_ids"
  while IFS= read -r id; do
    [[ -z "$id" ]] && continue
    if ! run_pactl_cmd unload-module "$id" >/dev/null 2>&1; then
      json_err "$requested" "pactl unload-module failed: null-sink id=$id" "close clients using sink and retry"
      exit 2
    fi
  done <<< "$sink_ids"
  json_ok "$requested" "deleted sink=$AUDIO_SINK_NAME source=$AUDIO_SOURCE_NAME"
}

audio_status() {
  local requested="audio:status"
  require_cmd pactl
  local sink_exists="false"
  local source_exists="false"
  local sinks
  if ! sinks="$(run_pactl_cmd list short sinks 2>&1)"; then
    json_err "$requested" "pactl list sinks failed: $sinks" "check PulseAudio/PipeWire runtime and permissions"
    exit 2
  fi
  if printf '%s\n' "$sinks" | awk '{print $2}' | grep -Fxq "$AUDIO_SINK_NAME"; then
    sink_exists="true"
  fi
  local sources
  if ! sources="$(run_pactl_cmd list short sources 2>&1)"; then
    json_err "$requested" "pactl list sources failed: $sources" "check PulseAudio/PipeWire runtime and permissions"
    exit 2
  fi
  if printf '%s\n' "$sources" | awk '{print $2}' | grep -Fxq "$AUDIO_SOURCE_NAME"; then
    source_exists="true"
  fi
  printf '{"ok":true,"requested":"%s","sinkExists":%s,"sinkName":"%s","sourceExists":%s,"sourceName":"%s"}\n' \
    "$requested" "$sink_exists" "$AUDIO_SINK_NAME" "$source_exists" "$AUDIO_SOURCE_NAME"
}

target="${1:-}"
action="${2:-}"
if [[ -z "$target" || -z "$action" || "$target" == "-h" || "$target" == "--help" ]]; then
  usage
  exit 1
fi
shift 2 || true

while [[ $# -gt 0 ]]; do
  case "$1" in
    --exclusive-caps)
      [[ $# -ge 2 ]] || fail "--exclusive-caps requires value 0 or 1"
      case "$2" in
        0|1) CAMERA_EXCLUSIVE_CAPS="$2" ;;
        *) fail "invalid --exclusive-caps value: $2 (expected 0 or 1)" ;;
      esac
      shift 2
      ;;
    *)
      fail "unknown option: $1"
      ;;
  esac
done

require_linux

if [[ -f "/.dockerenv" && "${AVC_DEVICE_VIA_HOST:-0}" == "1" ]]; then
  if [[ "${AVC_DEVICE_RELAYED:-0}" != "1" ]]; then
    if [[ "$target" == "audio" ]]; then
      if request_via_host_executor "$target" "$action"; then
        exit 0
      fi
      dbg "host executor relay failed for audio, falling back to nsenter relay"
    fi
    command -v nsenter >/dev/null 2>&1 || fail "nsenter is required in container for host relay."
    host_avc="${AVC_HOST_AVC_PATH:-/workspace/bin/avc}"
    dbg "relay start: target=$target action=$action host_avc=$host_avc host_user=${HOST_USER:-<empty>} host_uid=${HOST_UID:-<empty>} host_home=${HOST_HOME:-<empty>}"
    if [[ "$target" == "audio" && -n "$HOST_USER" ]]; then
      dbg "relay audio via sudo -iu login shell command passthrough: user=$HOST_USER"
      exec env \
        AVC_DEVICE_RELAYED=1 \
        AVC_OUTPUT_DEVICE="$CAMERA_DEVICE" \
        AVC_CAMERA_LABEL="$CAMERA_LABEL" \
        AVC_AUDIO_SINK_NAME="$AUDIO_SINK_NAME" \
        AVC_AUDIO_SINK_DESC="$AUDIO_SINK_DESC" \
        AVC_AUDIO_SOURCE_NAME="$AUDIO_SOURCE_NAME" \
        AVC_AUDIO_SOURCE_DESC="$AUDIO_SOURCE_DESC" \
        AVC_HOST_UID="$HOST_UID" \
        AVC_HOST_GID="$HOST_GID" \
        AVC_HOST_USER="$HOST_USER" \
        AVC_HOST_HOME="$HOST_HOME" \
        AVC_DEVICE_DEBUG="$DEBUG" \
        nsenter --target 1 --mount --uts --ipc --net --pid -- \
        sudo -iu "$HOST_USER" /bin/bash -lc \
        "'$host_avc' device '$target' '$action'"
    fi
    exec env \
      AVC_DEVICE_RELAYED=1 \
      AVC_OUTPUT_DEVICE="$CAMERA_DEVICE" \
      AVC_CAMERA_LABEL="$CAMERA_LABEL" \
      AVC_AUDIO_SINK_NAME="$AUDIO_SINK_NAME" \
      AVC_AUDIO_SINK_DESC="$AUDIO_SINK_DESC" \
      AVC_AUDIO_SOURCE_NAME="$AUDIO_SOURCE_NAME" \
      AVC_AUDIO_SOURCE_DESC="$AUDIO_SOURCE_DESC" \
      AVC_HOST_UID="$HOST_UID" \
      AVC_HOST_GID="$HOST_GID" \
      AVC_HOST_USER="$HOST_USER" \
      AVC_HOST_HOME="$HOST_HOME" \
      AVC_DEVICE_DEBUG="$DEBUG" \
      nsenter --target 1 --mount --uts --ipc --net --pid -- \
      "$host_avc" device "$target" "$action"
  fi
fi

case "$target:$action" in
  camera:create) camera_create ;;
  camera:delete) camera_delete ;;
  camera:status) camera_status ;;
  audio:create) audio_create ;;
  audio:delete) audio_delete ;;
  audio:status) audio_status ;;
  *) fail "unknown command: $target $action" ;;
esac
