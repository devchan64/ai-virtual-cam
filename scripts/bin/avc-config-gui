#!/usr/bin/env bash
set -euo pipefail
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

if python3 -c "import tkinter" >/dev/null 2>&1; then
  exec python3 "$ROOT_DIR/scripts/config/create-config-gui.py" "$@"
fi

if [[ -x "/opt/homebrew/bin/python3.12" ]] && /opt/homebrew/bin/python3.12 -c "import tkinter" >/dev/null 2>&1; then
  exec /opt/homebrew/bin/python3.12 "$ROOT_DIR/scripts/config/create-config-gui.py" "$@"
fi

echo "Tkinter is not available in current python3 and fallback python3.12." >&2
echo "Use CLI config instead: ./bin/avc config" >&2
echo "Or run directly with a Tk-enabled Python." >&2
exit 2
