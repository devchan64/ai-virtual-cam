#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
COMPOSE_FILE="$ROOT_DIR/docker/linux/compose.yml"
CONFIG_DIR="${AVC_CONFIG_DIR:-$HOME/.avc}"
CONFIG_FILE="$CONFIG_DIR/setting.json"
PROJECT_NAME="${AVC_DOCKER_PROJECT:-ai-virtual-cam}"
LOG_DIR="$ROOT_DIR/.tmp"
DEFAULT_INPUT_DEVICE="/dev/video0"
DEFAULT_OUTPUT_DEVICE="/dev/video10"
CONTAINER_CONFIG_FILE="/home/avc/.avc/setting.json"
DEVICE_REQUEST_DIR="${AVC_DEVICE_REQUEST_DIR:-$CONFIG_DIR/device-requests}"
CONTAINER_DEVICE_REQUEST_DIR="/home/avc/.avc/device-requests"

usage() {
  cat <<'EOF'
Usage:
  ./bin/avc docker <command> [args...]

Commands:
  config           Run GUI config inside Docker on Linux
  serve            Run pipeline inside Docker on Linux
  build            Build/update Docker image

Environment:
  AVC_CONFIG_DIR       Config directory mounted into container (default: ~/.avc)
  AVC_INPUT_DEVICE     Input camera device path (default: /dev/video0)
  AVC_OUTPUT_DEVICE    Output camera device path (default: /dev/video10)
  AVC_RUNTIME_DIR      Host runtime dir for Pulse/PipeWire socket mount (default: /run/user/<uid>)
  AVC_UID              UID mapped into container (default: current uid)
  AVC_GID              GID mapped into container (default: current gid)
  DISPLAY              Required for config GUI
EOF
}

fail() {
  echo "[avc-docker] ERROR: $*" >&2
  exit 2
}

require_linux() {
  if [[ "$(uname -s)" != "Linux" ]]; then
    fail "Docker workflow is supported only on Linux."
  fi
}

require_compose() {
  if docker compose version >/dev/null 2>&1; then
    return 0
  fi
  fail "docker compose is not available. Install Docker Compose v2 and retry."
}

ensure_config_dir() {
  mkdir -p "$CONFIG_DIR"
  mkdir -p "$DEVICE_REQUEST_DIR/pending" "$DEVICE_REQUEST_DIR/done" "$DEVICE_REQUEST_DIR/error"
}

default_runtime_dir() {
  local uid
  uid="${AVC_UID:-$(id -u)}"
  echo "/run/user/$uid"
}

device_gid() {
  local path="$1"
  stat -c '%g' "$path"
}

require_x11() {
  [[ -n "${DISPLAY:-}" ]] || fail "DISPLAY is not set. Export DISPLAY and allow local Docker access before running config."
  [[ -S /tmp/.X11-unix/X0 || -d /tmp/.X11-unix ]] || fail "/tmp/.X11-unix is missing. X11 socket mount is required for GUI config."
}

require_device() {
  local path="$1"
  local label="$2"
  [[ -n "$path" ]] || fail "$label is empty."
  [[ -e "$path" ]] || fail "$label does not exist: $path"
}

require_v4l2_output_capable() {
  local path="$1"
  if ! command -v v4l2-ctl >/dev/null 2>&1; then
    return 0
  fi

  local info
  info="$(v4l2-ctl -D -d "$path" 2>&1 || true)"
  if [[ -z "$info" ]]; then
    fail "Failed to inspect V4L2 device: $path"
  fi
  if ! printf '%s' "$info" | grep -qi "Video Output"; then
    fail "Configured output device is not V4L2 video output capable: $path. Recreate v4l2loopback device and retry."
  fi
}

cleanup_output_holders() {
  local path="$1"
  local enabled="${AVC_DOCKER_CLEAN_OUTPUT_HOLDERS:-1}"
  [[ "$enabled" == "1" ]] || return 0
  command -v fuser >/dev/null 2>&1 || return 0

  local pids
  pids="$(fuser "$path" 2>/dev/null || true)"
  if [[ -z "${pids// }" ]]; then
    return 0
  fi

  echo "[avc-docker] cleaning output holders on $path: $pids"
  kill -TERM $pids 2>/dev/null || true
  sleep 0.5
  local remain
  remain="$(fuser "$path" 2>/dev/null || true)"
  if [[ -n "${remain// }" ]]; then
    echo "[avc-docker] force killing remaining holders on $path: $remain"
    kill -KILL $remain 2>/dev/null || true
    sleep 0.2
  fi
}

timestamp_utc() {
  date -u +"%Y%m%dT%H%M%SZ"
}

run_compose() {
  local service="$1"
  shift

  local runtime_dir
  runtime_dir="${AVC_RUNTIME_DIR:-$(default_runtime_dir)}"
  local uid gid
  uid="${AVC_UID:-$(id -u)}"
  gid="${AVC_GID:-$(id -g)}"
  local xauthority
  xauthority="${XAUTHORITY:-$HOME/.Xauthority}"
  local input_gid
  input_gid="${AVC_INPUT_GID:-$(device_gid "${AVC_INPUT_DEVICE:-$DEFAULT_INPUT_DEVICE}")}"
  local output_device
  output_device="${AVC_OUTPUT_DEVICE:-$DEFAULT_OUTPUT_DEVICE}"

  AVC_UID="$uid" \
  AVC_GID="$gid" \
  AVC_HOST_UID="$uid" \
  AVC_HOST_GID="$gid" \
  AVC_HOST_USER="${USER:-}" \
  AVC_HOST_HOME="${HOME:-}" \
  AVC_CONFIG_DIR="$CONFIG_DIR" \
  AVC_RUNTIME_DIR="$runtime_dir" \
  AVC_INPUT_DEVICE="${AVC_INPUT_DEVICE:-$DEFAULT_INPUT_DEVICE}" \
  AVC_OUTPUT_DEVICE="$output_device" \
  AVC_INPUT_GID="$input_gid" \
  AVC_XAUTHORITY_HOST="$xauthority" \
  AVC_DEVICE_VIA_HOST="${AVC_DEVICE_VIA_HOST:-1}" \
  AVC_DEVICE_DEBUG="${AVC_DEVICE_DEBUG:-0}" \
  AVC_DEVICE_REQUEST_DIR="$CONTAINER_DEVICE_REQUEST_DIR" \
  AVC_DEVICE_REQUEST_DIR_HOST="$DEVICE_REQUEST_DIR" \
  AVC_HOST_AVC_PATH="${AVC_HOST_AVC_PATH:-$ROOT_DIR/bin/avc}" \
  docker compose -p "$PROJECT_NAME" -f "$COMPOSE_FILE" run --rm "$service" "$@"
}

start_host_device_executor() {
  local pid_file="$DEVICE_REQUEST_DIR/executor.pid"
  if [[ -f "$pid_file" ]]; then
    local old_pid
    old_pid="$(cat "$pid_file" 2>/dev/null || true)"
    if [[ -n "$old_pid" ]] && kill -0 "$old_pid" 2>/dev/null; then
      local cmdline=""
      cmdline="$(tr '\0' ' ' < "/proc/$old_pid/cmdline" 2>/dev/null || true)"
      if [[ "$cmdline" == *"avc-host-device-executor"* ]]; then
        return 0
      fi
    fi
  fi
  nohup "$ROOT_DIR/scripts/bin/avc-host-device-executor" >/tmp/avc-host-device-executor.log 2>&1 &
  echo "$!" > "$pid_file"
}

cmd="${1:-}"
if [[ -z "$cmd" || "$cmd" == "-h" || "$cmd" == "--help" ]]; then
  usage
  exit 0
fi
shift || true

require_linux
require_compose
ensure_config_dir

case "$cmd" in
  build)
    mkdir -p "$LOG_DIR"
    build_log="$LOG_DIR/docker-build-$(timestamp_utc).log"
    echo "[avc-docker] build log: $build_log"
    AVC_INPUT_DEVICE="${AVC_INPUT_DEVICE:-$DEFAULT_INPUT_DEVICE}" \
    AVC_OUTPUT_DEVICE="${AVC_OUTPUT_DEVICE:-$DEFAULT_OUTPUT_DEVICE}" \
    AVC_RUNTIME_DIR="${AVC_RUNTIME_DIR:-$(default_runtime_dir)}" \
    AVC_XAUTHORITY_HOST="${AVC_XAUTHORITY_HOST:-${XAUTHORITY:-/tmp/.docker.xauth}}" \
    AVC_UID="${AVC_UID:-$(id -u)}" \
    AVC_GID="${AVC_GID:-$(id -g)}" \
    AVC_INPUT_GID="${AVC_INPUT_GID:-44}" \
    docker compose -p "$PROJECT_NAME" -f "$COMPOSE_FILE" build 2>&1 | tee "$build_log"
    ;;
  config)
    require_x11
    require_device "${AVC_INPUT_DEVICE:-$DEFAULT_INPUT_DEVICE}" "AVC_INPUT_DEVICE"
    start_host_device_executor
    run_compose avc-config "$@"
    ;;
  serve)
    require_device "${AVC_INPUT_DEVICE:-$DEFAULT_INPUT_DEVICE}" "AVC_INPUT_DEVICE"
    require_device "${AVC_OUTPUT_DEVICE:-$DEFAULT_OUTPUT_DEVICE}" "AVC_OUTPUT_DEVICE"
    cleanup_output_holders "${AVC_OUTPUT_DEVICE:-$DEFAULT_OUTPUT_DEVICE}"
    require_v4l2_output_capable "${AVC_OUTPUT_DEVICE:-$DEFAULT_OUTPUT_DEVICE}"
    [[ -f "$CONFIG_FILE" ]] || fail "Config file not found: $CONFIG_FILE. Run './bin/avc docker config' first or provide AVC_CONFIG_DIR."
    run_compose avc-serve python3 -m src.app.main --config "$CONTAINER_CONFIG_FILE" "$@"
    ;;
  *)
    fail "Unknown docker command: $cmd"
    ;;
esac
