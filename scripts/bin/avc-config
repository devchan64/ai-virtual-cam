#!/usr/bin/env bash
set -euo pipefail
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
echo "[avc] NOTICE: CLI config(create-config.py)는 폐기되었습니다. GUI 설정기(config)로 전환합니다." >&2

if [[ "${1:-}" == "--docker" ]]; then
  shift
  output_path="${HOME}/.avc/setting.json"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --output)
        output_path="$2"
        shift 2
        ;;
      *)
        echo "unknown option for docker config: $1" >&2
        exit 2
        ;;
    esac
  done
  exec "$ROOT_DIR/scripts/bin/avc-docker-run" config "$output_path"
fi

exec "$ROOT_DIR/scripts/bin/avc-config-gui" "$@"
