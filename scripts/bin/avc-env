#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
VENV_DIR="$ROOT_DIR/.venv"
VENV_PY="$VENV_DIR/bin/python3"
LOCK_FILE="$ROOT_DIR/requirements.lock"

usage() {
  cat <<'EOF'
Usage:
  ./bin/avc env sync
EOF
}

cmd="${1:-}"
if [[ -z "$cmd" || "$cmd" == "-h" || "$cmd" == "--help" ]]; then
  usage
  exit 0
fi

if [[ "$cmd" != "sync" ]]; then
  echo "[avc-env] unknown command: $cmd" >&2
  usage >&2
  exit 2
fi

if [[ ! -f "$LOCK_FILE" ]]; then
  echo "[avc-env] lock file not found: $LOCK_FILE" >&2
  exit 2
fi

if [[ ! -x "$VENV_PY" ]]; then
  if command -v python3.12 >/dev/null 2>&1; then
    python3.12 -m venv "$VENV_DIR"
  else
    python3 -m venv "$VENV_DIR"
  fi
fi

"$VENV_PY" -m pip install --upgrade pip setuptools wheel
"$VENV_PY" -m pip install -r "$LOCK_FILE"

if [[ "$(uname -s)" == "Linux" ]]; then
  if ! "$VENV_PY" -m pip install --no-deps deepfilternet; then
    echo "[avc-env] WARN: deepfilternet install failed; denoise.backend=deepfilternet may be unavailable." >&2
  fi
fi

echo "[avc-env] sync completed (.venv + requirements.lock)"
