#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
VENV_DIR="$ROOT_DIR/.venv"
VENV_PY="$VENV_DIR/bin/python3"
REQUIREMENTS_FILE="$ROOT_DIR/requirements.txt"
INSTALL_DEEPFILTERNET="${AVC_INSTALL_DEEPFILTERNET:-0}"

usage() {
  cat <<'EOF'
Usage:
  ./bin/avc env sync
EOF
}

cmd="${1:-}"
if [[ -z "$cmd" || "$cmd" == "-h" || "$cmd" == "--help" ]]; then
  usage
  exit 0
fi

if [[ "$cmd" != "sync" ]]; then
  echo "[avc-env] unknown command: $cmd" >&2
  usage >&2
  exit 2
fi

if [[ ! -f "$REQUIREMENTS_FILE" ]]; then
  echo "[avc-env] requirements file not found: $REQUIREMENTS_FILE" >&2
  exit 2
fi

if [[ ! -x "$VENV_PY" ]]; then
  if command -v python3.12 >/dev/null 2>&1; then
    python3.12 -m venv "$VENV_DIR"
  else
    python3 -m venv "$VENV_DIR"
  fi
fi

"$VENV_PY" -m pip install -r "$REQUIREMENTS_FILE"

if [[ "$(uname -s)" == "Linux" ]]; then
  if [[ "$INSTALL_DEEPFILTERNET" == "1" ]]; then
    if ! "$VENV_PY" -m pip install --no-deps deepfilternet; then
      echo "[avc-env] WARN: deepfilternet install failed; denoise.backend=deepfilternet may be unavailable." >&2
    fi
  else
    echo "[avc-env] info: skipping optional deepfilternet install (set AVC_INSTALL_DEEPFILTERNET=1 to enable)." >&2
  fi
fi

echo "[avc-env] sync completed (.venv + requirements.txt)"
