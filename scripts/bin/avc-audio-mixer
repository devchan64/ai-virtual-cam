#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
VENV_PY="$ROOT_DIR/.venv/bin/python3"

if [[ ! -x "$VENV_PY" ]]; then
  echo ".venv python not found: $VENV_PY" >&2
  echo "Run ./bin/avc setup first." >&2
  exit 1
fi

cd "$ROOT_DIR"
exec "$VENV_PY" -m src.app.audio_main "$@"
