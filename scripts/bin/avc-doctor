#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
VENV_PY="$ROOT_DIR/.venv/bin/python3"
CONFIG_PATH="${HOME}/.avc/setting.json"
OS_NAME="$(uname -s)"
ok=1

log() {
  echo "[doctor] $*"
}

warn() {
  echo "[doctor] WARN: $*" >&2
}

fail() {
  echo "[doctor] ERROR: $*" >&2
  ok=0
}

if ! command -v python3 >/dev/null 2>&1; then
  fail "missing: python3"
else
  log "ok: python3 available"
fi

if [[ -x "$VENV_PY" ]]; then
  if "$VENV_PY" -c "import tkinter, cv2" >/dev/null 2>&1; then
    log "ok: .venv tkinter/cv2 available"
  else
    fail ".venv exists but tkinter/cv2 missing; run ./bin/avc setup"
  fi
else
  fail ".venv missing; run ./bin/avc setup"
fi

if ! command -v docker >/dev/null 2>&1; then
  warn "missing: docker (optional for local run)"
else
  log "ok: docker available"
fi

if [[ -f "$CONFIG_PATH" ]]; then
  backend="$(python3 - <<PY
import json
from pathlib import Path
p = Path("$CONFIG_PATH")
try:
    data = json.loads(p.read_text())
    print(data.get("outputCamera", {}).get("backend", "unknown"))
except Exception:
    print("invalid")
PY
)"
  log "config: $CONFIG_PATH backend=$backend"
else
  warn "config not found: $CONFIG_PATH (run ./bin/avc config)"
fi

if [[ "$OS_NAME" == "Darwin" ]]; then
  log "macOS OBS 경로 진단 시작"
  obs_ext_active=0
  obs_device_visible=0
  if command -v obs >/dev/null 2>&1 || [[ -d "/Applications/OBS.app" ]]; then
    log "ok: OBS installed"
  else
    fail "OBS not installed"
  fi

  if command -v systemextensionsctl >/dev/null 2>&1; then
    ext_line="$(systemextensionsctl list 2>/dev/null | grep -Ei "com\.obsproject\.obs-studio\.mac-camera-extension|OBS Virtual Camera" || true)"
    if [[ -n "$ext_line" ]]; then
      obs_ext_active=1
      log "ok: OBS camera extension detected"
      echo "$ext_line"
    else
      warn "OBS camera extension not detected in systemextensionsctl (권한/상태 확인 필요)"
    fi
  else
    warn "systemextensionsctl command unavailable"
  fi

  if command -v ffmpeg >/dev/null 2>&1; then
    log "avfoundation devices (OBS 포함 여부 확인)"
    avf_lines="$(ffmpeg -f avfoundation -list_devices true -i "" 2>&1 || true)"
    echo "$avf_lines" | grep -Ei "AVFoundation video devices|OBS Virtual Camera|FaceTime|Continuity|Camera" || true
    if echo "$avf_lines" | grep -q "OBS Virtual Camera"; then
      obs_device_visible=1
      log "ok: OBS Virtual Camera is visible in AVFoundation list"
    else
      warn "OBS Virtual Camera is not visible in AVFoundation list"
    fi
  else
    warn "ffmpeg not found; run ./bin/avc setup"
  fi

  if [[ "$obs_ext_active" -eq 1 && "$obs_device_visible" -eq 0 ]]; then
    warn "확장은 활성화되어 있으나 장치가 노출되지 않습니다."
    warn "macOS 재부팅 후 다시 ./bin/avc doctor 를 실행하세요."
    warn "재부팅 후에도 미노출이면 OBS를 열어 Start/Stop Virtual Camera를 1회 수행하세요."
  fi
fi

if [[ "$ok" -eq 1 ]]; then
  log "checks passed"
  exit 0
fi
exit 1
