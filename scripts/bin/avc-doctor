#!/usr/bin/env bash
set -euo pipefail

ok=1
if ! command -v python3 >/dev/null 2>&1; then
  echo "[doctor] missing: python3" >&2
  ok=0
fi
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
VENV_PY="$ROOT_DIR/.venv/bin/python3"
if [[ -x "$VENV_PY" ]]; then
  if "$VENV_PY" -c "import tkinter, cv2, pyvirtualcam" >/dev/null 2>&1; then
    :
  else
    echo "[doctor] .venv exists but tkinter/cv2/pyvirtualcam missing; run ./bin/avc setup" >&2
  fi
else
  echo "[doctor] .venv missing; run ./bin/avc setup" >&2
fi
if ! command -v docker >/dev/null 2>&1; then
  echo "[doctor] missing: docker (optional for local run)" >&2
fi
if [[ "$ok" -eq 1 ]]; then
  echo "[doctor] basic checks passed"
  exit 0
fi
exit 1
