#!/usr/bin/env bash
set -euo pipefail

ok=1
if ! command -v python3 >/dev/null 2>&1; then
  echo "[doctor] missing: python3" >&2
  ok=0
fi
if ! command -v docker >/dev/null 2>&1; then
  echo "[doctor] missing: docker (optional for local run)" >&2
fi
if [[ "$ok" -eq 1 ]]; then
  echo "[doctor] basic checks passed"
  exit 0
fi
exit 1
